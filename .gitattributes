# Set default behavior to automatically normalize line endings
* text=auto

# Enforce Unix LF line endings for all shell and bash scripts
*.sh text eol=lf
*.bash text eol=lf

# Configuration & data files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.env* text eol=lf

# Windows scripts enforce CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
