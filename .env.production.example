# =============================================================================
# DevCenterPoint ProERP — Production Environment Template
# Target: Websuru cPanel Hosting — MySQL — Apache — No Docker — No Redis
# Platform: proerp.devcenterpoint.com
# Tenants: {slug}.devcenterpoint.com + verified custom domains
#
# IMPORTANT: Copy this file to backend/.env and fill in all values marked
#            REPLACE_THIS before deploying.
#
# DO NOT commit a populated .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
APP_NAME="DevCenterPoint ProERP"
APP_ENV=production
APP_KEY=base64:kRuMt2muBz1vtVd+gKhU/Fo5Dyp+5dzOBrHoLPLtryA=
APP_DEBUG=false
APP_URL=https://proerp.devcenterpoint.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# -----------------------------------------------------------------------------
# Platform Identity — used by TenantResolver and URL generators
# Do NOT hardcode these values anywhere in source code; always read from config.
# -----------------------------------------------------------------------------
PLATFORM_NAME="DevCenterPoint"
MASTER_DOMAIN=proerp.devcenterpoint.com
TENANT_BASE_DOMAIN=devcenterpoint.com

# -----------------------------------------------------------------------------
# Database — MySQL via Websuru cPanel
# Use the cPanel Database Wizard to create the database and user.
# cPanel typically provides a hostname of "localhost" for MySQL.
# utf8mb4 + InnoDB is mandatory; do not change charset/collation.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=devcente_proerp
DB_USERNAME=devcente_proerpusr
DB_PASSWORD=A7p}s1@ajndR^qon
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=false

# -----------------------------------------------------------------------------
# Cache — database driver (no Redis required on cPanel)
# Every tenant cache key is prefixed with the tenant ID in application code.
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=proerp_cache

# -----------------------------------------------------------------------------
# Queue — database driver (no Supervisor/Redis required on cPanel)
# Worker is driven by cPanel cron: see docs/QUEUE_SCHEDULER_SETUP.md
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Session — database driver with secure cookie settings
# SESSION_DOMAIN: set to .devcenterpoint.com to share across subdomains,
# OR leave null and rely on per-subdomain cookie isolation.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.devcenterpoint.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# JWT Authentication (ADR-007)
# Generate JWT_SECRET with: openssl rand -base64 64
# Rotate JWT_SECRET requires all active sessions to re-authenticate.
# -----------------------------------------------------------------------------
JWT_SECRET=3120fe277fce192ec16dee3e4b2081f04c93154e8916e597adcc97acf500af4f
JWT_TTL=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_COOKIE_DOMAIN=.devcenterpoint.com
REFRESH_TOKEN_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing
# List every origin that may call the API. Do not use wildcard (*) in prod.
# Add verified custom tenant domains here as they are onboarded, OR
# implement dynamic CORS via the TenantResolver (see docs/PRODUCTION_ARCHITECTURE.md).
# -----------------------------------------------------------------------------
# All named tenant subdomains that call /api/*.
# The cors.php regex pattern also auto-allows ANY *.devcenterpoint.com origin,
# so wildcard tenants work without editing this list.
CORS_ALLOWED_ORIGINS=https://proerp.devcenterpoint.com,https://demoerp.devcenterpoint.com,https://devcenterpoint.com

# -----------------------------------------------------------------------------
# Logging — daily rotating files, error level only in production
# Logs live in backend/storage/logs/ — ensure write permissions.
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Mail — configure with your hosting mail account
# Websuru cPanel typically provides SMTP on port 465 (SSL) or 587 (STARTTLS).
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.devcenterpoint.com
MAIL_PORT=465
MAIL_USERNAME=admin@devcenterpoint.com
MAIL_PASSWORD=Admin@DCP2026
MAIL_FROM_ADDRESS=admin@devcenterpoint.com
MAIL_FROM_NAME="DevCenterPoint ProERP"

# -----------------------------------------------------------------------------
# File Storage
# FILESYSTEM_DISK=local uses backend/storage/app/
# Tenant files are stored at storage/app/tenants/{tenant_id}/
# Ensure backend/storage/ and subdirectories are writable by the web server.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Broadcast (disabled — WebSocket/Reverb not supported on cPanel shared hosting)
# Real-time features fall back to polling where implemented.
# See docs/PRODUCTION_ARCHITECTURE.md §8 for details.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Frontend Build-time Variables (injected by Vite at build time)
# These are ONLY used during `npm run build` — they are baked into the JS bundle.
# The production build must always be built with VITE_ENABLE_MOCK=false.
# -----------------------------------------------------------------------------
# =============================================================================
# Frontend build: run `npm run build` locally in the frontend/ directory.
# Upload the generated frontend/dist/ contents to:
#   /home/devcente/projects/proerp/public/
# (Do NOT run the build on the cPanel server — no Node.js available via Git VC)
# =============================================================================
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE="DevCenterPoint ProERP"
VITE_ENABLE_MOCK=false
VITE_MASTER_DOMAIN=proerp.devcenterpoint.com
VITE_TENANT_BASE_DOMAIN=devcenterpoint.com
