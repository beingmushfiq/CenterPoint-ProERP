# =============================================================================
# DevCenterPoint ProERP — Backend Production Environment Template
# Target: Websuru cPanel Hosting — MySQL — Apache — No Docker — No Redis
# Platform: proerp.devcenterpoint.com
# Tenants: {slug}.devcenterpoint.com + verified custom domains
#
# Usage:
#   cp .env.production.example .env
#   php artisan key:generate
#   Fill in database credentials and secrets marked REPLACE_THIS
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
APP_NAME="DevCenterPoint ProERP"
APP_ENV=production
APP_KEY=base64:kRuMt2muBz1vtVd+gKhU/Fo5Dyp+5dzOBrHoLPLtryA=
APP_DEBUG=false
APP_URL=https://proerp.devcenterpoint.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Platform & Domain Identity
# -----------------------------------------------------------------------------
PLATFORM_NAME="DevCenterPoint"
MASTER_DOMAIN=proerp.devcenterpoint.com
TENANT_BASE_DOMAIN=devcenterpoint.com

# -----------------------------------------------------------------------------
# Database — MySQL via Websuru cPanel
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=devcente_proerp
DB_USERNAME=devcente_proerpusr
DB_PASSWORD=A7p}s1@ajndR^qon
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT=false

# -----------------------------------------------------------------------------
# Cache & Queue — Database driven for cPanel compatibility
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=proerp_cache
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Session — Database driven
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.devcenterpoint.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Logging — Daily rotating logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Custom JWT Authentication (ADR-007)
# -----------------------------------------------------------------------------
JWT_SECRET=3120fe277fce192ec16dee3e4b2081f04c93154e8916e597adcc97acf500af4f
JWT_TTL=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_COOKIE_DOMAIN=.devcenterpoint.com
REFRESH_TOKEN_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Filesystem & Storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail Configuration (cPanel SMTP)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.devcenterpoint.com
MAIL_PORT=465
MAIL_USERNAME=admin@devcenterpoint.com
MAIL_PASSWORD=Admin@DCP2026
MAIL_FROM_ADDRESS=admin@devcenterpoint.com
MAIL_FROM_NAME="DevCenterPoint ProERP"

# -----------------------------------------------------------------------------
# Broadcast (Disabled / Log driver for cPanel)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# CORS Configuration
# All named tenant subdomains that call /api/*.
# The cors.php regex also auto-allows ANY *.devcenterpoint.com origin at runtime,
# so wildcard tenants work without changing this list.
# Deployed document root: /home/devcente/projects/proerp/public/
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://proerp.devcenterpoint.com,https://demoerp.devcenterpoint.com,https://devcenterpoint.com
