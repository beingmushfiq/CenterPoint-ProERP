APP_NAME=SliceMartERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Connection (Default SQLite for local dev, MySQL/PostgreSQL for production)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=slicemart_erp
# DB_USERNAME=root
# DB_PASSWORD=

# Session Management
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Broadcasting, File Storage & Queues
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# DB_QUEUE_TABLE=jobs
# DB_QUEUE_RETRY_AFTER=90

# Cache Configuration
CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=slicemart_cache

# Redis (When using Redis for Cache/Queue/Sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@slicemart.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS & Frontend Origins (GAP-012)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & API Rate Limiting (GAP-012)
API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
TOKEN_EXPIRATION_MINUTES=1440
IDEMPOTENCY_CACHE_TTL=86400

# Multi-Tenancy & Operations (GAP-004, GAP-011)
TENANT_CACHE_PREFIX=t
TENANT_PROFILE_CACHE_TTL=3600
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=ops@slicemart.com

# AWS / S3 Compatible Object Storage (Optional for offsite backups/attachments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Client Frontend
VITE_APP_NAME="${APP_NAME}"
