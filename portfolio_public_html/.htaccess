# ==============================================================================
# DevCenterPoint Portfolio — Apache config for devcenterpoint.com
# Document root: /home/devcente/public_html/
# ==============================================================================

<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. Enforce HTTPS across all hostnames
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Block sensitive files and directories
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # 3. Subdomain Routing:
    # Direct all subdomain requests (proerp, demoerp, tenant slugs) to proerp-app
    
    # 3a. Serve existing static assets directly from proerp-app
    RewriteCond %{HTTP_HOST} !^(www\.)?devcenterpoint\.com$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/proerp-app/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/proerp-app/$1 -d
    RewriteRule ^(.*)$ proerp-app/$1 [L,QSA]

    # 3b. Route API, Health, and Up endpoints directly to Laravel index.php
    RewriteCond %{HTTP_HOST} !^(www\.)?devcenterpoint\.com$ [NC]
    RewriteCond %{REQUEST_URI} (^|/)(index\.php/)?(api|up|health) [NC]
    RewriteRule ^(.*)$ proerp-app/index.php [L,QSA]

    # 3c. SPA fallback: Route client browser navigation (/login, /dashboard, etc.) to index.html
    RewriteCond %{HTTP_HOST} !^(www\.)?devcenterpoint\.com$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteRule ^(.*)$ proerp-app/index.html [L,QSA]

    # 3d. Pass any remaining dynamic mutations to Laravel index.php
    RewriteCond %{HTTP_HOST} !^(www\.)?devcenterpoint\.com$ [NC]
    RewriteRule ^(.*)$ proerp-app/index.php [L,QSA]

    # 4. Main domain (devcenterpoint.com): Serve existing files/directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Main domain (devcenterpoint.com): Portfolio static fallback
    RewriteCond %{HTTP_HOST} ^(www\.)?devcenterpoint\.com$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy strict-origin-when-cross-origin
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Cache static assets
    <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # No-cache on HTML to ensure updates reflect instantly
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
